{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "model": "cards",
      "filter": "cards",
      "plugins": {
        "da": {
          "name": "cards",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Card Item",
      "id": "cards-item",
      "model": "cards-item",
      "plugins": {
        "da": {
          "name": "cards-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "picture>img[src]" },
            { "name": "imageAlt", "selector": "picture>img[alt]" },
            { "name": "text", "selector": ":is(.cards-card-body,.cards-feature-caption,.cards-category-label,.cards-recipe-foot,.cards-recipeb-body,.cards-coupon-info,div:nth-child(2))" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Variant",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Links", "value": "links" },
            { "name": "Product carousel", "value": "product" },
            { "name": "Category grid", "value": "category" },
            { "name": "Recipe carousel", "value": "recipe" },
            { "name": "Recipe carousel B", "value": "recipe-b" },
            { "name": "Feature (up to 4)", "value": "feature" },
            { "name": "Coupon carousel", "value": "coupon" }
          ]
        }
      ]
    },
    {
      "id": "cards-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false,
          "description": "Optional. Block renders without image when empty."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt Text",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": ["cards-item"]
    }
  ]
}

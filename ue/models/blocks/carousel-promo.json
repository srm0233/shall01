{
  "definitions": [
    {
      "title": "Carousel Promo",
      "id": "carousel-promo",
      "model": "carousel-promo",
      "filter": "carousel-promo",
      "plugins": {
        "da": {
          "name": "carousel-promo",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Carousel Promo Slide",
      "id": "carousel-promo-item",
      "model": "carousel-promo-item",
      "plugins": {
        "da": {
          "name": "carousel-promo-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel-promo",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "value": "",
          "label": "Default panel color (fallback)",
          "description": "Optional fallback panel colour for slides that don't set their own. Per slide, add a line with a hex colour (e.g. #c2185b) to override. Slides with no colour (and no fallback) show a full-width image.",
          "options": [
            { "name": "None (full-width images)", "value": "" },
            { "name": "Brand blue", "value": "blue" },
            { "name": "Green", "value": "green" },
            { "name": "Purple", "value": "purple" },
            { "name": "Peach", "value": "peach" },
            { "name": "Ink (near-black)", "value": "ink" }
          ]
        }
      ]
    },
    {
      "id": "carousel-promo-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false,
          "description": "Slide background / promo image."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt Text",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Text",
          "valueType": "string",
          "description": "Heading, description and CTA link for the slide."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel-promo",
      "components": ["carousel-promo-item"]
    }
  ]
}

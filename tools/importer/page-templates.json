          ],
          "defaultContent": []
        },
        {
          "id": "rc-featured",
          "name": "section-featured",
          "selector": [
            "body > main.main-wrapper > div.full-bleed-container > div.full-bleed-row > div.master-product-carousel.section.static-carousel"
          ],
          "style": "grey",
          "blocks": [
